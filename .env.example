# GitHub token used by the existing content-management APIs.
GITHUB_TOKEN=
GITHUB_OWNER=yangwei2future
GITHUB_REPO=yangwei

# GitHub OAuth App credentials. Keep the secret server-side only.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Exact callback configured in the GitHub OAuth App.
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Comma-separated stable numeric GitHub user IDs allowed to administer the blog.
GITHUB_ADMIN_IDS=

# Local HTTP must remain false. Production HTTPS sets Secure automatically.
AUTH_COOKIE_SECURE=false
